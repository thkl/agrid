{
  "name": "agrid",
  "version": "0.1.9",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "node scripts/bump-library-version.mjs && ng build agrid-package",
    "build:demo": "ng build",
    "copy:local": "node scripts/copy-library-source.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --config=playwright.performance.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "homepage": "https://thkl.github.io/agrid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thkl/agrid.git"
  },
  "bugs": {
    "url": "https://github.com/thkl/agrid/issues"
  },
  "packageManager": "pnpm@11.6.0",
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.17",
    "@angular/router": "21.2.17",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.16",
    "@angular/cli": "21.2.16",
    "@angular/compiler-cli": "21.2.17",
    "@playwright/test": "^1.60.0",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
